# Rename this file to .env and fill in your keys

# Required — used by the OpenAI Agents SDK (main agent) and by the LangChain
# SQL chains inside each DB tool
OPENAI_API_KEY=sk-...

# Required — used by MedicalWebSearchTool
TAVILY_API_KEY=tvly-...

# Optional — override if you place the .db files somewhere else
HEART_DISEASE_DB_PATH=db/heart_disease.db
CANCER_DB_PATH=db/cancer.db
DIABETES_DB_PATH=db/diabetes.db
